# Copie para .env (NUNCA faça commit do .env). Guia completo no README.
NODE_ENV=development
PORT=8080

# Conexão ADMIN (somente scripts: migrate / seed / criar-usuario). Nunca vai para a aplicação.
# Supabase > Connect > Session pooler (porta 5432), com a senha do banco
DATABASE_URL_ADMIN=postgresql://postgres.SEU_PROJECT_REF:SENHA_DO_BANCO@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Conexão da APLICAÇÃO (role de menor privilégio mentor_app, porta 6543).
# Invente uma senha forte (16+ caracteres): o "npm run migrate" aplica essa senha no banco.
DATABASE_URL=postgresql://mentor_app.SEU_PROJECT_REF:SENHA_INVENTADA_FORTE@aws-0-us-east-2.pooler.supabase.com:6543/postgres
SYNC_APP_PASSWORD=1
DB_POOL_MAX=10
# Opcional: certificado CA do Supabase em base64 para validar o TLS (Database > Settings > SSL)
DB_SSL_CA_BASE64=

# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
COOKIE_SECURE=false
TRUST_PROXY=1
ALLOWED_ORIGINS=http://localhost:8080

# Senha dos usuários de demonstração (npm run seed:demo)
SEED_PASSWORD="Demo#Mentor2026"
