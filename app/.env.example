# Copie para .env (NUNCA faça commit do .env)
NODE_ENV=development
PORT=8080

# Conexão da APLICAÇÃO (role de menor privilégio mentor_app, via pooler do Supabase - porta 6543)
DATABASE_URL=postgresql://mentor_app.SEU_PROJECT_REF:SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_POOL_MAX=10
# Certificado CA do Supabase em base64 (Project Settings > Database > SSL) -> base64 -w0 prod-ca-2021.crt
DB_SSL_CA_BASE64=

# Conexão ADMIN (somente scripts: migrate / seed / criar-usuario). Nunca vai para a aplicação.
DATABASE_URL_ADMIN=postgresql://postgres.SEU_PROJECT_REF:SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=2h
COOKIE_SECURE=false
TRUST_PROXY=1
ALLOWED_ORIGINS=http://localhost:8080
